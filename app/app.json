{
  "expo": {
    "name": "Survival Manual",
    "slug": "survival-manual",
    "scheme": "survivalmanual",
    "version": "6.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.midnightcoder.survivalmanual",
      "supportsTablet": true
    },
    "android": {
      "package": "com.midnightcoder.survivalmanual",
      "versionCode": 600
    },
    "web": {
      "output": "static",
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "backgroundColor": "#455440"
        }
      ],
      "expo-sqlite",
      "expo-localization",
      [
        "expo-camera",
        {
          "cameraPermission": "Used only to switch on the flashlight for SOS signals.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Used only to show true north on the compass."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-asset"
    ]
  }
}
