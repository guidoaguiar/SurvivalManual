{
  "name": "app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "expo": "~56.0.23",
    "expo-asset": "~56.0.25",
    "expo-audio": "~56.0.13",
    "expo-camera": "~56.0.8",
    "expo-constants": "~56.0.27",
    "expo-font": "~56.0.7",
    "expo-keep-awake": "~56.0.3",
    "expo-linking": "~56.0.18",
    "expo-localization": "~56.0.6",
    "expo-location": "~56.0.26",
    "expo-router": "~56.2.21",
    "expo-speech": "~56.0.3",
    "expo-splash-screen": "~56.0.15",
    "expo-sqlite": "~56.0.6",
    "expo-status-bar": "~56.0.4",
    "i18next": "^26.4.6",
    "minisearch": "^7.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.18",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.8.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/hast": "^3.0.5",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.6.5",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~56.0.4",
    "fast-xml-parser": "^5.11.2",
    "image-size": "^2.0.4",
    "jest": "^29.7.0",
    "jest-expo": "~56.0.5",
    "react-test-renderer": "^19.2.3",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "unified": "^11.0.5",
    "workbox-build": "^7.4.1"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:content": "tsx --test scripts/content/*.test.mts",
    "content": "tsx scripts/build-content.mts",
    "export:web": "npm run content && expo export -p web && node scripts/pwa.mjs",
    "prestart": "npm run content",
    "preweb": "npm run content",
    "preandroid": "npm run content",
    "preios": "npm run content",
    "pretest": "npm run content",
    "pretypecheck": "npm run content",
    "eas-build-pre-install": "cd .. && git submodule update --init --depth 1",
    "eas-build-post-install": "npm run content"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./jest.setup.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/scripts/"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  },
  "overrides": {
    "expo-asset": "~56.0.25"
  }
}
